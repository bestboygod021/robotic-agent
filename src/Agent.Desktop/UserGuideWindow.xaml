<Window x:Class="Agent.Desktop.UserGuideWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="راهنمای جامع کار با نرم‌افزار و مربی هوشمند / Complete User Guide (FA/EN)"
        Width="1040"
        Height="780"
        MinWidth="820"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        FontFamily="Tahoma, Segoe UI"
        Background="#F4F6FA"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header & Bilingual Switcher -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#D8DEE9" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="HeaderTitleText"
                               Text="📖 راهنمای جامع کار با نرم‌افزار، پرامپت‌ساز هوشمند و مرکز نسخهٔ حرفه‌ای (FA / EN)"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#182230" />
                    <TextBlock x:Name="HeaderSubtitleText"
                               Text="آموزش گام‌به‌گام ۲۱ مهارت آفلاین، ۲۰ قالب شغلی، ۲۰۰ ابزار هوش مصنوعی، حباب Drag &amp; Drop و مدیریت لایسنس"
                               Margin="0,5,0,0"
                               Foreground="#475467"
                               TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ToggleLanguageButton"
                            Content="🌐 تغییر زبان راهنما: فارسی ⇄ English"
                            Padding="14,8"
                            Background="#EFF8FF"
                            Foreground="#175CD3"
                            BorderBrush="#B2DDFF"
                            FontWeight="SemiBold"
                            Click="ToggleLanguageButton_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Interactive Quick Bar: Search + Prompt Coach + Magic Drop-Zone + License/ROI -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#D8DEE9" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="1.1*" />
                </Grid.ColumnDefinitions>

                <!-- Left/Right Column 1: Interactive Prompt Coach & Search -->
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="🔍 جست‌وجو در سرفصل‌های آموزشی / Search Tutorial Sections:" FontWeight="SemiBold" Foreground="#344054" Margin="0,0,0,4" />
                    <TextBox x:Name="SearchGuideBox" Padding="8,6" TextChanged="SearchGuideBox_TextChanged" Margin="0,0,0,10" />

                    <TextBlock Text="✨ دستیار پرامپت‌ساز تعاملی (Interactive Prompt Coach — با حذف خودکار اطلاعات محرمانه):"
                               FontWeight="SemiBold"
                               Foreground="#175CD3"
                               Margin="0,0,0,4" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="PromptGoalTextBox"
                                 Grid.Column="0"
                                 Padding="8,6"
                                 Text="می‌خواهم یک ایمیل رسمی خلاصهٔ فاکتورهای ماهانه برای مشتری بنویسم" />
                        <Button Grid.Column="1"
                                Content="ساخت پرامپت حرفه‌ای"
                                Margin="6,0,0,0"
                                Padding="12,6"
                                Background="#1570EF"
                                Foreground="White"
                                BorderThickness="0"
                                Click="BuildPromptButton_Click" />
                        <Button Grid.Column="2"
                                Content="کپی پرامپت"
                                Margin="6,0,0,0"
                                Padding="10,6"
                                Background="#EEF2F7"
                                Foreground="#182230"
                                Click="CopyPromptButton_Click" />
                    </Grid>
                    <TextBox x:Name="PromptCoachOutputBox"
                             Margin="0,6,0,0"
                             Height="74"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Background="#F8FAFC"
                             BorderBrush="#CBD5E1"
                             Padding="8,6" />
                </StackPanel>

                <!-- Column 2: Magic Drop-Zone + Pro/Lifetime License + Viral Impact Card -->
                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                    <Border Background="#F0F9FF" BorderBrush="#7CD4FD" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="🎯 حباب هوشمند کشیدن و رها کردن فایل (Magic Drop-Zone — فایل را اینجا رها کنید)"
                                       FontWeight="Bold"
                                       Foreground="#026AA2" />
                            <TextBlock x:Name="DropZoneStatusText"
                                       Text="هر عکس، PDF، جدول CSV یا پوشه‌ای را بکشید و روی این پنجره رها کنید تا ۳ اقدام هوشمند پیشنهاد شود."
                                       Foreground="#065986"
                                       FontSize="12"
                                       Margin="0,4,0,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Background="#ECFDF3" BorderBrush="#ABEFC6" BorderThickness="1" CornerRadius="6" Padding="10">
                        <StackPanel>
                            <TextBlock x:Name="LicenseStatusText"
                                       Text="سطح فعلی: نسخهٔ رایگان (Free) — برای باز کردن ۲۰ قالب شغلی، لایسنس Pro یا Lifetime وارد کنید"
                                       FontWeight="SemiBold"
                                       Foreground="#067647"
                                       TextWrapping="Wrap" />
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="LicenseKeyTextBox" Grid.Column="0" Padding="6,5" />
                                <Button Grid.Column="1"
                                        Content="فعال‌سازی لایسنس"
                                        Margin="6,0,0,0"
                                        Padding="10,5"
                                        Background="#067647"
                                        Foreground="White"
                                        BorderThickness="0"
                                        Click="ActivateLicenseButton_Click" />
                                <Button Grid.Column="2"
                                        Content="🏆 ذخیرهٔ کارت کارنامهٔ بهره‌وری (SVG)"
                                        Margin="6,0,0,0"
                                        Padding="10,5"
                                        Background="#175CD3"
                                        Foreground="White"
                                        BorderThickness="0"
                                        Click="ExportImpactCardButton_Click" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Scrollable Bilingual Tutorial Sections -->
        <ListBox x:Name="GuideSectionsList"
                 Grid.Row="2"
                 Background="#FFFFFF"
                 BorderBrush="#D8DEE9"
                 BorderThickness="1"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="#E4E7EC" BorderThickness="0,0,0,1" Padding="16,14" Background="#FFFFFF">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding BadgeIcon}" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold" Foreground="#182230" VerticalAlignment="Center" TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBlock Text="{Binding Summary}"
                                       Margin="0,6,0,8"
                                       Foreground="#344054"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding Steps}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}"
                                                   Margin="8,3,8,3"
                                                   Foreground="#475467"
                                                   TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border Background="#FFFAEB" BorderBrush="#FEDF89" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,8,0,0">
                                <TextBlock Text="{Binding ProTip}" Foreground="#B54708" FontWeight="SemiBold" TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>
