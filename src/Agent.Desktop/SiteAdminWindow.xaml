<Window x:Class="Agent.Desktop.SiteAdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="⚙️ پنل مدیریت جامع سایت، محتوا، ۴۶ مدل اشتراک و ۶ درگاه پرداخت (Site Admin &amp; CMS)"
        Width="1140"
        Height="820"
        MinWidth="880"
        MinHeight="660"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        FontFamily="Tahoma, Segoe UI"
        Background="#F4F6FA">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Row 0: Header & Quick Admin Actions -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#D8DEE9" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="⚙️ مرکز مدیریت کل سایت، هدر، هیرو، ۴۶ اشتراک و ۶ درگاه پرداخت (Site Admin CMS)"
                               FontSize="17"
                               FontWeight="Bold"
                               Foreground="#182230" />
                    <TextBlock Text="ویرایش بدون کدنویسی تمامی بخش‌های سایت، قیمت‌گذاری تومانی/دلاری ۴۶ پلن، کدهای مرچنت ۶ درگاه و خروجی JSON"
                               Margin="0,4,0,0"
                               Foreground="#475467" />
                </StackPanel>

                <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                    <Button Content="💾 ذخیره و تولید JSON سایت"
                            Padding="14,8"
                            Margin="0,0,8,0"
                            Background="#1570EF"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="SemiBold"
                            Click="SaveAndExportJson_Click" />
                    <Button Content="🔥 اعمال ۲۰٪ تخفیف روی ۴۶ اشتراک"
                            Padding="12,8"
                            Margin="0,0,8,0"
                            Background="#067647"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="SemiBold"
                            Click="ApplyBulkDiscount20_Click" />
                    <Button Content="🔄 بازگردانی پیش‌فرض"
                            Padding="12,8"
                            Click="ResetDefaults_Click" />
                </WrapPanel>
            </Grid>
        </Border>

        <!-- Row 1: TabControl for Complete Site Management -->
        <TabControl Grid.Row="1" Background="#FFFFFF" BorderBrush="#D8DEE9">
            <!-- Tab 1: Branding, Hero, Sections & SEO -->
            <TabItem Header="🎨 ۱. مدیریت هدر، بنر، هیرو، بخش‌ها و سئو" Padding="14,8">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                    <StackPanel>
                        <TextBlock Text="ویرایش متن‌ها و ظاهر صفحهٔ اصلی سایت (web/index.html):" FontWeight="Bold" FontSize="14" Margin="0,0,0,10" />

                        <WrapPanel Margin="0,0,0,12">
                            <CheckBox x:Name="ShowTopBannerCheck" Content="نمایش بنر اعلان بالای سایت" IsChecked="True" Margin="0,0,18,0" />
                            <CheckBox x:Name="ShowHeroSectionCheck" Content="نمایش بخش هیرو (Hero)" IsChecked="True" Margin="0,0,18,0" />
                            <CheckBox x:Name="ShowFeaturesSectionCheck" Content="نمایش کارت‌های ویژگی" IsChecked="True" Margin="0,0,18,0" />
                            <CheckBox x:Name="ShowRoiSectionCheck" Content="نمایش ماشین‌حساب ROI" IsChecked="True" Margin="0,0,18,0" />
                            <CheckBox x:Name="ShowPricingSectionCheck" Content="نمایش جدول قیمت" IsChecked="True" Margin="0,0,18,0" />
                            <CheckBox x:Name="MaintenanceModeCheck" Content="🚧 حالت تعمیر سایت (Maintenance)" IsChecked="False" />
                        </WrapPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="نام برند در هدر سایت:" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBox x:Name="BrandNameBox" Padding="8,6" Margin="0,0,0,10" />

                                <TextBlock Text="متن بنر اعلان بالای سایت (فارسی):" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBox x:Name="TopBannerFaBox" Padding="8,6" Margin="0,0,0,10" />

                                <TextBlock Text="تیتر اصلی صفحهٔ اول (Hero Title - فارسی):" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBox x:Name="HeroTitleFaBox" Padding="8,6" Margin="0,0,0,10" />

                                <TextBlock Text="زیرتیتر صفحهٔ اول (Subtitle - فارسی):" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBox x:Name="HeroSubtitleFaBox" Padding="8,6" Margin="0,0,0,10" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="عنوان سئو (SEO Meta Title):" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBox x:Name="SeoTitleBox" Padding="8,6" Margin="0,0,0,10" />

                                <TextBlock Text="توضیحات متا سئو (SEO Meta Description):" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBox x:Name="SeoDescriptionBox" Padding="8,6" Margin="0,0,0,10" />

                                <TextBlock Text="شناسهٔ همکاری در فروش ۲۰۰ ابزار هوش مصنوعی (Affiliate Partner ID):" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBox x:Name="AffiliateIdBox" Padding="8,6" Margin="0,0,0,10" />

                                <TextBlock Text="کد رنگ اصلی و مکمل سایت (Primary / Accent Hex):" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBox x:Name="PrimaryColorBox" Padding="8,6" Margin="0,0,0,10" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 2: 46 Subscription Models & Pricing Editor -->
            <TabItem Header="📦 ۲. مدیریت ۴۶ مدل اشتراک و قیمت‌گذاری" Padding="14,8">
                <Grid Margin="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <ListBox x:Name="AdminPlansListBox"
                             Grid.Column="0"
                             SelectionChanged="AdminPlansListBox_SelectionChanged" />

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="ویرایش طرح اشتراک انتخاب‌شده:" FontWeight="Bold" FontSize="14" Margin="0,0,0,10" />
                        <CheckBox x:Name="PlanEnabledCheck" Content="این طرح اشتراک در فروشگاه فعال باشد" IsChecked="True" Margin="0,0,0,10" />

                        <TextBlock Text="عنوان فارسی طرح:" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBox x:Name="PlanTitleFaBox" Padding="8,6" Margin="0,0,0,10" />

                        <TextBlock Text="قیمت تومانی (تومان — درگاه‌های ایرانی):" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBox x:Name="PlanPriceTomanBox" Padding="8,6" Margin="0,0,0,10" />

                        <TextBlock Text="قیمت دلاری (USD — درگاه‌های خارجی):" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBox x:Name="PlanPriceUsdBox" Padding="8,6" Margin="0,0,0,10" />

                        <TextBlock Text="سقف پردازش فایل در هر نوبت:" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBox x:Name="PlanBatchLimitBox" Padding="8,6" Margin="0,0,0,12" />

                        <Button Content="✓ ثبت تغییر این اشتراک"
                                Padding="12,9"
                                Background="#1570EF"
                                Foreground="White"
                                BorderThickness="0"
                                FontWeight="SemiBold"
                                Click="UpdateSelectedPlanButton_Click" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Tab 3: 6 Payment Gateways Configuration -->
            <TabItem Header="🏦 ۳. مدیریت ۶ درگاه پرداخت (۳ ایرانی + ۳ خارجی)" Padding="14,8">
                <Grid Margin="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="1.1*" />
                    </Grid.ColumnDefinitions>

                    <ListBox x:Name="AdminGatewaysListBox"
                             Grid.Column="0"
                             SelectionChanged="AdminGatewaysListBox_SelectionChanged" />

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="تنظیمات درگاه پرداخت انتخاب‌شده:" FontWeight="Bold" FontSize="14" Margin="0,0,0,10" />
                        <CheckBox x:Name="GatewayEnabledCheck" Content="فعال بودن درگاه در صفحهٔ پرداخت" IsChecked="True" Margin="0,0,0,8" />
                        <CheckBox x:Name="GatewaySandboxCheck" Content="حالت آزمایشی (Sandbox Mode)" IsChecked="False" Margin="0,0,0,10" />

                        <TextBlock Text="کد مرچنت یا کلید API درگاه (Merchant ID / Secret Key):" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBox x:Name="GatewayMerchantKeyBox" Padding="8,6" Margin="0,0,0,10" />

                        <TextBlock Text="آدرس بازگشت از درگاه (Callback URL):" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBox x:Name="GatewayCallbackUrlBox" Padding="8,6" Margin="0,0,0,12" />

                        <Button Content="✓ ذخیرهٔ تنظیمات درگاه"
                                Padding="12,9"
                                Background="#067647"
                                Foreground="White"
                                BorderThickness="0"
                                FontWeight="SemiBold"
                                Click="UpdateSelectedGatewayButton_Click" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Tab 4: Complete JSON Config Export & Preview -->
            <TabItem Header="📦 ۴. خروجی کامل تنظیمات سایت (Site JSON Config)" Padding="14,8">
                <Grid Margin="14">
                    <TextBox x:Name="SiteJsonExportBox"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas, Tahoma"
                             FlowDirection="LeftToRight"
                             Background="#F8FAFC"
                             Padding="10" />
                </Grid>
            </TabItem>

            <!-- Tab 5: Phase 1 Cybersecurity, 2FA, Webhook HMAC, Hardware Key & Audit Chain (#1..#10) -->
            <TabItem Header="🛡️ ۵. امنیت سایبری فاز ۱ (2FA، زنجیرهٔ هش و ضدتقلب)" Padding="14,8">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <WrapPanel Grid.Row="0" Margin="0,0,0,12">
                        <Button Content="🔐 تولید کد ۶ رقمی TOTP و کدهای بازیابی (#1)"
                                Padding="12,8"
                                Margin="0,0,8,0"
                                Click="RunPhase1TotpButton_Click" />
                        <Button Content="🔏 تست امضای HMAC وب‌هوک و قفل سخت‌افزاری (#2, #4)"
                                Padding="12,8"
                                Margin="0,0,8,0"
                                Click="RunPhase1WebhookAndHwButton_Click" />
                        <Button Content="⛓️ بررسی زنجیرهٔ هش حسابرسی مدیر و گزارش Trust (#5, #10)"
                                Padding="12,8"
                                Background="#067647"
                                Foreground="White"
                                BorderThickness="0"
                                Click="RunPhase1AuditAndTrustReportButton_Click" />
                    </WrapPanel>

                    <TextBox x:Name="Phase1SecurityOutputBox"
                             Grid.Row="1"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas, Tahoma"
                             FlowDirection="LeftToRight"
                             Background="#F8FAFC"
                             Padding="10" />
                </Grid>
            </TabItem>

            <!-- Tab 6: Phase 4 Admin CMS Pro & Marketing Automation (#31..#40) -->
            <TabItem Header="🚀 ۶. بازاریابی، A/B تست، وب‌هوک و تسویه ۷۰/۳۰ (فاز ۴)" Padding="14,8">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <WrapPanel Grid.Row="0" Margin="0,0,0,12">
                        <Button Content="🧪 گزارش تست A/B و سطوح دسترسی RBAC (#32, #34)"
                                Padding="12,8"
                                Margin="0,0,8,0"
                                Click="RunPhase4AbAndRbacButton_Click" />
                        <Button Content="📲 وب‌هوک تلگرام/بله/اسلک و Schema.org سئو (#35, #37)"
                                Padding="12,8"
                                Margin="0,0,8,0"
                                Click="RunPhase4WebhookAndSchemaButton_Click" />
                        <Button Content="💸 صف تسویه ۷۰/۳۰ ناشران پلاگین و کمپین مناسبتی (#38, #40)"
                                Padding="12,8"
                                Background="#1570EF"
                                Foreground="White"
                                BorderThickness="0"
                                Click="RunPhase4PayoutsAndCampaignButton_Click" />
                    </WrapPanel>

                    <TextBox x:Name="Phase4MarketingOutputBox"
                             Grid.Row="1"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas, Tahoma"
                             FlowDirection="LeftToRight"
                             Background="#F8FAFC"
                             Padding="10" />
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Row 2: Status Footer -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#D8DEE9" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,12,0,0">
            <TextBlock x:Name="AdminStatusText"
                       Text="آمادهٔ مدیریت تمامی بخش‌های سایت، ۴۶ مدل اشتراک و ۶ درگاه پرداخت."
                       Foreground="#067647"
                       FontWeight="SemiBold" />
        </Border>
    </Grid>
</Window>
