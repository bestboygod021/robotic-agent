<Window x:Class="Agent.Desktop.WorkflowStudioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="⚡ استودیو گردش‌کار چندمرحله‌ای، ۲۰ قالب شغلی و اسکنر حریم خصوصی"
        Width="1060"
        Height="780"
        MinWidth="840"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        FontFamily="Tahoma, Segoe UI"
        Background="#F4F6FA">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#D8DEE9" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="⚡ استودیو گردش‌کار چندمرحله‌ای (Workflow Studio)، ۲۰ قالب آمادهٔ شغلی و ممیزی حریم خصوصی"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="#182230" />
                <TextBlock Text="انتخاب یک‌کلیکی پایپ‌لاین‌های حسابداری، حقوقی، منابع انسانی، تولید محتوا، پشتیبانی و IT همراه با پیش‌نمایش سرتاسری (Dry-Run) و واگرد معکوس کل مراحل"
                           Margin="0,5,0,0"
                           Foreground="#475467"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Folders & Privacy Risk Scanner Bar -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#D8DEE9" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="پوشهٔ مبدأ گردش‌کار / اسکن حریم خصوصی:" FontWeight="SemiBold" Foreground="#344054" Margin="0,0,0,4" />
                        <TextBox x:Name="SourceDirTextBox" Padding="8,6" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="پوشهٔ مقصد خروجی‌های گردش‌کار:" FontWeight="SemiBold" Foreground="#344054" Margin="0,0,0,4" />
                        <TextBox x:Name="OutputDirTextBox" Padding="8,6" />
                    </StackPanel>

                    <Button x:Name="RunPrivacyScanButton"
                            Grid.Column="3"
                            Content="🛡️ اسکن ریسک حریم خصوصی پوشهٔ مبدأ"
                            Margin="12,18,0,0"
                            Padding="14,8"
                            Background="#FEF3F2"
                            Foreground="#B42318"
                            BorderBrush="#FECDCA"
                            FontWeight="SemiBold"
                            Click="RunPrivacyScanButton_Click" />
                </Grid>

                <Border x:Name="PrivacyReportBanner"
                        Background="#FFFAEB"
                        BorderBrush="#FEDF89"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="10,8"
                        Margin="0,10,0,0"
                        Visibility="Collapsed">
                    <TextBlock x:Name="PrivacyReportText"
                               Foreground="#B54708"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </Border>

        <!-- Main Studio Split: 20 SMB Playbooks List + Step Dry-Run Preview -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="1.25*" />
            </Grid.ColumnDefinitions>

            <!-- Playbooks Catalog -->
            <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#D8DEE9" BorderThickness="1" CornerRadius="8" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="📚 کتابخانهٔ ۲۰ قالب آمادهٔ شغلی (SMB Playbooks):" FontWeight="Bold" Foreground="#182230" Margin="0,0,0,8" />
                    <ListBox x:Name="PlaybooksListBox"
                             Grid.Row="1"
                             BorderBrush="#E4E7EC"
                             SelectionChanged="PlaybooksListBox_SelectionChanged" />
                </Grid>
            </Border>

            <!-- Dry-Run Step Preview & Controls -->
            <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#D8DEE9" BorderThickness="1" CornerRadius="8" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="SelectedPlaybookTitleText"
                               Grid.Row="0"
                               Text="یک قالب شغلی را از فهرست انتخاب کنید"
                               FontSize="15"
                               FontWeight="Bold"
                               Foreground="#182230"
                               TextWrapping="Wrap" />

                    <WrapPanel Grid.Row="1" Margin="0,10,0,10">
                        <Button x:Name="DryRunPreviewButton"
                                Content="۱. پیش‌نمایش سرتاسری (Dry-Run)"
                                Padding="12,7"
                                Margin="0,0,8,0"
                                Background="#EFF8FF"
                                Foreground="#175CD3"
                                BorderBrush="#B2DDFF"
                                FontWeight="SemiBold"
                                Click="DryRunPreviewButton_Click" />
                        <Button x:Name="ExecuteWorkflowButton"
                                Content="۲. تأیید و اجرای زنجیره‌ای"
                                Padding="14,7"
                                Margin="0,0,8,0"
                                Background="#1570EF"
                                Foreground="White"
                                BorderThickness="0"
                                FontWeight="SemiBold"
                                IsEnabled="False"
                                Click="ExecuteWorkflowButton_Click" />
                        <Button x:Name="RollbackWorkflowButton"
                                Content="↩️ واگرد کامل کل گردش‌کار"
                                Padding="12,7"
                                Margin="0,0,8,0"
                                Background="#FEF3F2"
                                Foreground="#B42318"
                                BorderBrush="#FECDCA"
                                FontWeight="SemiBold"
                                IsEnabled="False"
                                Click="RollbackWorkflowButton_Click" />
                        <Button x:Name="ExportJsonButton"
                                Content="برون‌ریزی .agentflow.json"
                                Padding="10,7"
                                Background="#F2F4F7"
                                Foreground="#344054"
                                Click="ExportJsonButton_Click" />
                    </WrapPanel>

                    <ListBox x:Name="StepPreviewListBox"
                             Grid.Row="2"
                             BorderBrush="#E4E7EC" />
                </Grid>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="3" Background="#FFFFFF" BorderBrush="#D8DEE9" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,12,0,0">
            <TextBlock x:Name="StudioStatusText"
                       Text="آماده — پوشهٔ مبدأ و مقصد را وارد کرده و یکی از ۲۰ قالب شغلی را انتخاب کنید."
                       Foreground="#344054"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap" />
        </Border>
    </Grid>
</Window>
