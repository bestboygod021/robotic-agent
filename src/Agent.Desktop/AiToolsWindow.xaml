<Window x:Class="Agent.Desktop.AiToolsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="کاتالوگ ابزارهای هوش مصنوعی"
        Width="1240" Height="860" MinWidth="960" MinHeight="680"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        FontFamily="Segoe UI"
        Background="#F4F6FA"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <SolidColorBrush x:Key="InkBrush" Color="#182230" />
        <SolidColorBrush x:Key="MutedBrush" Color="#667085" />
        <SolidColorBrush x:Key="AccentBrush" Color="#5B5CE2" />
        <Style x:Key="FilterTextBox" TargetType="TextBox">
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#182230" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D0D5DD" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="SecondaryToolButton" TargetType="Button">
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#344054" />
            <Setter Property="Background" Value="#F2F4F7" />
            <Setter Property="BorderBrush" Value="#D0D5DD" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header + Language Selector -->
        <Border Grid.Row="0" Background="White" CornerRadius="16" Padding="18,14" BorderBrush="#EAECF0" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="HeaderTitleText" Text="کاتالوگ ابزارهای هوش مصنوعی" FontSize="20" FontWeight="Bold" Foreground="{StaticResource InkBrush}" />
                    <TextBlock x:Name="HeaderSubtitleText" Text="۲۰۰ ابزار منتخب در ۸ دسته؛ توصیه‌گر هوشمند، مقایسهٔ رودررو، پرامپت آماده و پیوند مستقیم" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" />
                </StackPanel>
                <Border Grid.Column="1" Background="#F2F4F7" BorderBrush="#EAECF0" BorderThickness="1" CornerRadius="16" Padding="12,6" VerticalAlignment="Center">
                    <TextBlock x:Name="OfflineBadgeText" Text="کاتالوگ آفلاین؛ بدون ارسال خودکار داده" Foreground="#475467" FontSize="11" FontWeight="SemiBold" />
                </Border>
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="LanguageLabelText" Text="زبان:" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="#475467" Margin="0,0,8,0" />
                    <ComboBox x:Name="LanguagePicker" Width="136" Padding="10,6" FontSize="12" DisplayMemberPath="NativeName" SelectedValuePath="Code" SelectionChanged="LanguagePicker_SelectionChanged" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Smart AI Tool Matchmaker Row (#61) -->
        <Border Grid.Row="2" Background="#EEF4FF" CornerRadius="12" Padding="14,10" BorderBrush="#C7D7FE" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="ProblemBox" Grid.Column="0" Style="{StaticResource FilterTextBox}" VerticalContentAlignment="Center" ToolTip="شرح مشکل یا نیاز به هر زبان (Ctrl+M)" />
                <Button x:Name="MatchmakerButton" Grid.Column="2" Content="پیشنهاد هوشمند ابزار" Style="{StaticResource ToolButton}" Click="MatchmakerButton_Click" />
                <Button x:Name="ClearMatchmakerButton" Grid.Column="4" Content="نمایش همه" Style="{StaticResource SecondaryToolButton}" Click="ClearMatchmakerButton_Click" />
            </Grid>
        </Border>

        <!-- Category + Search + Filter Toggles (#8, #62, #67) -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="1.45*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="CategoryPicker" Grid.Column="0" Padding="12,8" FontSize="13" Background="White" BorderBrush="#D0D5DD" BorderThickness="1" VerticalContentAlignment="Center" DisplayMemberPath="DisplayName" SelectedValuePath="Id" />
            <Grid Grid.Column="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="SearchLabelText" Text="جست‌وجو" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="#475467" Margin="0,0,8,0" />
                <TextBox x:Name="SearchBox" Grid.Column="1" Style="{StaticResource FilterTextBox}" VerticalContentAlignment="Center" ToolTip="جست‌وجو در نام، دسته، توضیح، تگ‌ها و نشانی وب (Ctrl+F)" />
            </Grid>
            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox x:Name="FavoritesOnlyCheck" Content="فقط ستاره‌دارها" VerticalAlignment="Center" Margin="0,0,10,0" Checked="FilterOption_Changed" Unchecked="FilterOption_Changed" />
                <CheckBox x:Name="FreeTierOnlyCheck" Content="دارای پلن رایگان" VerticalAlignment="Center" Margin="0,0,10,0" Checked="FilterOption_Changed" Unchecked="FilterOption_Changed" />
                <Button x:Name="CompareToolsButton" Content="مقایسهٔ ابزارهای انتخاب‌شده (0)" Style="{StaticResource SecondaryToolButton}" Click="CompareToolsButton_Click" />
            </StackPanel>
        </Grid>

        <!-- Results Summary -->
        <TextBlock x:Name="ResultsText" Grid.Row="6" FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />

        <!-- Side-by-Side Comparison Drawer (#62) -->
        <Border x:Name="ComparisonPanel" Grid.Row="8" Visibility="Collapsed" Background="White" CornerRadius="12" Padding="14,10" Margin="0,0,0,8" BorderBrush="#5B5CE2" BorderThickness="1.5">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ComparisonHeaderText" Text="ماتریس مقایسهٔ رودرروی ابزارها" FontSize="13" FontWeight="Bold" Foreground="{StaticResource InkBrush}" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="بستن مقایسه ✕" Style="{StaticResource SecondaryToolButton}" Click="CloseComparisonButton_Click" />
                </Grid>
                <ItemsControl x:Name="ComparisonList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#F8FAFC" BorderBrush="#EAECF0" BorderThickness="1" CornerRadius="10" Padding="10" Margin="4">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold" Foreground="#182230" />
                                    <TextBlock Text="{Binding CategoryName}" FontSize="11" Foreground="#5B5CE2" Margin="0,2,0,4" />
                                    <TextBlock Text="{Binding PrivacyPosture}" FontSize="11" Foreground="#027A48" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding FreeTierStatus}" FontSize="11" Foreground="#475467" Margin="0,2,0,4" />
                                    <TextBlock Text="{Binding Description}" FontSize="11" Foreground="#475467" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Tools Virtualized List -->
        <Border Grid.Row="9" Background="White" CornerRadius="14" Padding="12" BorderBrush="#EAECF0" BorderThickness="1">
            <Grid>
                <ListBox x:Name="ToolList" BorderThickness="0" Background="Transparent" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Focusable" Value="False" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#FFFFFF" BorderBrush="#EAECF0" BorderThickness="1" CornerRadius="12" Padding="13" Margin="2,2,2,9">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="56" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Local Icon Badge + Vector Category Glyph (#70) -->
                                    <StackPanel Grid.Column="0" VerticalAlignment="Top">
                                        <Border x:Name="ToolIcon" Width="48" Height="48" CornerRadius="13" Background="#475467">
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <Path Data="{Binding CategoryIconGeometry}" Stroke="White" StrokeThickness="1.3" Stretch="Uniform" Width="13" Height="13" Margin="0,0,0,2" HorizontalAlignment="Center" />
                                                <TextBlock Text="{Binding IconText}" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                        <Button Content="{Binding FavoriteSymbol}" FontSize="14" Background="Transparent" BorderThickness="0" Foreground="#F79009" Cursor="Hand" Margin="0,4,0,0" ToolTip="افزودن/حذف از علاقه‌مندی‌ها" Click="FavoriteButton_Click" />
                                    </StackPanel>

                                    <!-- Tool Metadata, Privacy Badge & Matchmaker Reason -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <WrapPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="Bold" Foreground="#182230" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <Border Background="#F2F4F7" CornerRadius="8" Padding="7,2" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding CategoryName}" FontSize="10" Foreground="#475467" />
                                            </Border>
                                            <Border Background="#ECFDF3" CornerRadius="8" Padding="7,2" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding PrivacyBadgeLabel}" FontSize="10" Foreground="#027A48" FontWeight="SemiBold" />
                                            </Border>
                                            <Border Background="#EFF8FF" CornerRadius="8" Padding="7,2" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding FreeTierBadge}" FontSize="10" Foreground="#175CD3" />
                                            </Border>
                                            <CheckBox Content="مقایسه" IsChecked="{Binding IsSelectedForComparison, Mode=OneWay}" Click="ComparisonCheckBox_Click" FontSize="11" Foreground="#475467" VerticalAlignment="Center" />
                                        </WrapPanel>

                                        <TextBlock Text="{Binding MatchmakerReason}" Visibility="{Binding HasMatchmakerReason, Converter={StaticResource BoolToVis}}" FontSize="11" FontWeight="SemiBold" Foreground="#1570EF" Margin="0,5,0,0" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding DescriptionFa}" FontSize="12" Foreground="#475467" TextWrapping="Wrap" Margin="0,5,0,4" />
                                        <TextBlock Text="{Binding LoginUrl}" FontSize="10" Foreground="#5B5CE2" TextTrimming="CharacterEllipsis" ToolTip="{Binding LoginUrl}" FlowDirection="LeftToRight" TextAlignment="Right" />
                                    </StackPanel>

                                    <!-- Actions Column (#64, #66, #69) -->
                                    <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="12,0,0,0">
                                        <Button Content="{Binding LaunchButtonLabel}" Style="{StaticResource ToolButton}" Click="OpenToolButton_Click" ToolTip="بازکردن وب‌سایت رسمی در مرورگر پیش‌فرض" />
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0" HorizontalAlignment="Center">
                                            <Button Content="کپی پرامپت" Style="{StaticResource SecondaryToolButton}" Click="CopyPromptButton_Click" Margin="0,0,4,0" ToolTip="{Binding StarterPrompt}" />
                                            <Button Content="ورود امن" Style="{StaticResource SecondaryToolButton}" Click="SafeHandoffButton_Click" ToolTip="حذف خودکار مسیر/ایمیل/تلفن از متن مشکل، کپی پرامپت امن و بازکردن ابزار" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding CategoryId}" Value="chat"><Setter TargetName="ToolIcon" Property="Background" Value="#5B5CE2" /></DataTrigger>
                                <DataTrigger Binding="{Binding CategoryId}" Value="research"><Setter TargetName="ToolIcon" Property="Background" Value="#1570EF" /></DataTrigger>
                                <DataTrigger Binding="{Binding CategoryId}" Value="writing"><Setter TargetName="ToolIcon" Property="Background" Value="#039855" /></DataTrigger>
                                <DataTrigger Binding="{Binding CategoryId}" Value="image"><Setter TargetName="ToolIcon" Property="Background" Value="#D444F1" /></DataTrigger>
                                <DataTrigger Binding="{Binding CategoryId}" Value="video"><Setter TargetName="ToolIcon" Property="Background" Value="#F79009" /></DataTrigger>
                                <DataTrigger Binding="{Binding CategoryId}" Value="audio"><Setter TargetName="ToolIcon" Property="Background" Value="#E04F9A" /></DataTrigger>
                                <DataTrigger Binding="{Binding CategoryId}" Value="coding"><Setter TargetName="ToolIcon" Property="Background" Value="#344054" /></DataTrigger>
                                <DataTrigger Binding="{Binding CategoryId}" Value="productivity"><Setter TargetName="ToolIcon" Property="Background" Value="#0797A8" /></DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="EmptyStateText" Text="ابزاری با این عبارت پیدا نشد." Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15" Foreground="{StaticResource MutedBrush}" />
            </Grid>
        </Border>

        <TextBlock x:Name="FooterDisclaimerText" Grid.Row="11" Text="آیکون‌ها نشان‌های حروفی و برداری محلی‌اند، نه لوگوی رسمی. با انتخاب دکمهٔ بازکردن، مرورگر پیش‌فرض شما وب‌سایت ابزار را باز می‌کند؛ حساب و دسترسی تابع همان سرویس است." FontSize="10" Foreground="#667085" TextWrapping="Wrap" />
    </Grid>
</Window>
